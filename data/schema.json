        "credit"
      ],
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/httpsURL"
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "placeEssay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "paragraphs",
        "photos"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 40
          }
        },
        "photos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/placePhoto"
          }
        }
      }
    },
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "caption",
        "image"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person",
            "animal"
          ],
          "description": "person 表示美女：年轻、貌美的女性，可以是演员、模特、运动员等。必须是真实照片，优先公开活动、红毯或编辑图片，得体、不裸露，并写明署名。不要用年长者充数，也不要用生成图。animal 表示动物，同样要真实照片和署名。"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
