    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "title",
        "path"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/isoDate"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^issues/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indexEntry"
          }
        }
      }
    },
    "photoOfDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "interpretation",
        "image",
        "sources"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "description": "至少三段、用空行分开。"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "placePhoto": {
      "type": "object",
      "additionalProperties": false,
