                    },
                    {
                      "properties": {
                        "name": {
                          "const": "科学与体育"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/newsSection"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "影视与明星"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/newsSection"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "书籍与作家"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/gallerySection"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "美女与野兽"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/placeSection"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "天涯海角"
                        }
                      }
                    }
                  ]
                },
